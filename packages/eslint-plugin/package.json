{
  "name": "eslint-plugin-namespaced-storage",
  "version": "1.0.0",
  "description": "ESLint rules that keep browser storage behind a namespaced store: no raw localStorage, literal namespaces, reserved keys, co-located declarations.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "localstorage",
    "sessionstorage",
    "namespaced-storage"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build && publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/estree": "^1.0.9",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "publint": "^0.2.12",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayan1998/namespaced-storage.git",
    "directory": "packages/eslint-plugin"
  }
}
