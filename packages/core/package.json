{
  "name": "namespaced-storage",
  "version": "0.1.0",
  "description": "Namespaced, type-safe, SSR-safe wrapper over localStorage and sessionStorage. Zero dependencies.",
  "keywords": [
    "localstorage",
    "sessionstorage",
    "namespace",
    "storage",
    "typescript",
    "type-safe",
    "ssr"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "pnpm build && publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "publint": "^0.2.12",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "name": "namespacing + codecs (no schema)",
      "path": "dist/index.js",
      "import": "{ createLocalStorage }",
      "limit": "6.4 kB"
    },
    {
      "name": "+ the built-in t.* schemas",
      "path": "dist/index.js",
      "import": "{ createLocalStorage, t }",
      "limit": "7 kB"
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayanmirzaei/namespaced-storage.git",
    "directory": "packages/core"
  }
}
